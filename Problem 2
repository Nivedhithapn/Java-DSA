import java.util.Scanner;

class Main{
    public static void main(String[] args){
        Scanner scan=new Scanner(System.in);
        int a=scan.nextInt();
        int b=scan.nextInt();
        int c=scan.nextInt();
        int sum=a+b+c;
        
        if(sum==180){
            System.out.println("Triangle Formed");
        }
        else{
            System.out.println("Triangle not Formed");
        }
    }
}
